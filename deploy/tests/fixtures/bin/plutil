#!/bin/bash

set -eu

extract_path=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -extract)
            extract_path="${2:-}"
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

input="$(cat)"
case "${extract_path}" in
    0.configuration.labels)
        label="$(printf '%s' "${input}" | sed -n 's/.*"org\.sub2api\.stack":"\([^"]*\)".*/\1/p')"
        if [[ -z "${label}" ]]; then
            echo '{}'
        else
            printf '{"org.sub2api.stack":"%s"}\n' "${label}"
        fi
        ;;
    0.configuration.ipv4Subnet)
        subnet="$(printf '%s' "${input}" | sed -n 's/.*"ipv4Subnet":"\([^"]*\)".*/\1/p')"
        [[ -n "${subnet}" ]]
        printf '%s\n' "${subnet}"
        ;;
    0.status.networks.0.ipv4Address)
        address="$(printf '%s' "${input}" | sed -n 's/.*"ipv4Address":"\([^"]*\)".*/\1/p')"
        [[ -n "${address}" ]]
        printf '%s\n' "${address}"
        ;;
    *)
        printf 'unsupported fake plutil extraction: %s\n' "${extract_path}" >&2
        exit 1
        ;;
esac
